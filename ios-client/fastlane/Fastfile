default_platform(:ios)

platform :ios do
  desc "Build an UNSIGNED PhoneVR .app archive - sign/install it yourself with Sideloadly"
  lane :build do
    # No cert/sigh/match here on purpose: Apple's public Developer Portal API
    # (what fastlane's cert/sigh use) rejects plain free Apple IDs for
    # non-interactive login. Sideloadly works around that with its own
    # Anisette-based client (the same private protocol Xcode uses), so we
    # stop trying to sign in CI and just hand Sideloadly a clean, unsigned
    # build to sign+install locally, exactly like the manual builds that
    # already worked for you.
    gym(
      project: "PhoneVR.xcodeproj",
      scheme: "PhoneVR",
      skip_package_ipa: true,
      export_method: "development",
      output_directory: "build",
      archive_path: "build/PhoneVR.xcarchive",
      # Ad-hoc sign (CODE_SIGN_IDENTITY=-) rather than fully disabling
      # codesigning: a binary with no LC_CODE_SIGNATURE at all trips up
      # resigning tools like Sideloadly ("Invalid file"). Ad-hoc gives it a
      # placeholder signature Sideloadly can cleanly strip and replace.
      xcargs: "CODE_SIGNING_ALLOWED=YES CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY=- " \
              "PROVISIONING_PROFILE_SPECIFIER= DEVELOPMENT_TEAM= " \
              "CODE_SIGN_STYLE=Manual"
    )
  end
end
